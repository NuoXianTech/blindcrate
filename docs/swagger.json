                        "type": "string",
                        "description": "RFC3339, 包含",
                        "name": "start_time",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "name": "target_id",
                        "in": "query"
                    },
                    {
                        "maxLength": 32,
                        "type": "string",
                        "name": "target_type",
                        "in": "query"
